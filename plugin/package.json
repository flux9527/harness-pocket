{
  "name": "dsh-mobile-console",
  "version": "0.1.0",
  "description": "手机控制台：在手机浏览器上查看 DSH 会话状态、审批请求、发消息注入会话、回答提问。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "dsh-plugin",
    "mobile",
    "remote",
    "approval",
    "lan"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "boot.js",
  "exports": {
    ".": "./boot.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "boot.js",
    "client.js",
    "src/",
    "ui/",
    "tools/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/all.test.mjs",
    "live-check": "node tools/live-check.mjs",
    "live-answer": "node tools/live-answer.mjs",
    "live-send": "node tools/live-send.mjs"
  }
}
